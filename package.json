{
  "name": "ununique",
  "version": "1.3.1",
  "private": true,
  "packageManager": "bun@1.3.8",
  "type": "commonjs",
  "scripts": {
    "build": "bun scripts/sync-manifest.ts && tsc -p tsconfig.json && bun scripts/copy-static.ts",
    "format": "prettier --write \"src/**/*.{ts,html,json}\" \"test/**/*.html\" \"*.{json,mjs}\" \"scripts/**/*.ts\"",
    "format-check": "prettier --check \"src/**/*.{ts,html,json}\" \"test/**/*.html\" \"*.{json,mjs}\" \"scripts/**/*.ts\"",
    "lint": "eslint .",
    "package": "bun run build && bun run stage-extension && web-ext build --source-dir build/extension --artifacts-dir web-ext-artifacts --overwrite-dest --filename ununique.xpi",
    "preview": "bun run build && web-ext run --source-dir .",
    "stage-extension": "bun scripts/sync-manifest.ts && bun scripts/stage-extension.ts",
    "sync-manifest": "bun scripts/sync-manifest.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "bun run type-check",
    "web-ext:lint": "bun run build && bun run stage-extension && web-ext lint --source-dir build/extension"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "web-ext": "^10.5.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.8",
    "fast-uri": "4.1.1",
    "js-yaml": "5.2.2",
    "shell-quote": "1.10.0",
    "undici": "8.9.0"
  }
}
