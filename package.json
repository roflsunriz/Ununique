{
  "name": "ununique",
  "version": "1.2.0",
  "private": true,
  "packageManager": "bun@1.3.8",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && bun scripts/copy-static.ts",
    "format": "prettier --write \"src/**/*.{ts,html,json}\" \"test/**/*.html\" \"*.{json,mjs}\" \"scripts/**/*.ts\"",
    "format-check": "prettier --check \"src/**/*.{ts,html,json}\" \"test/**/*.html\" \"*.{json,mjs}\" \"scripts/**/*.ts\"",
    "lint": "eslint .",
    "preview": "bun run build && web-ext run --source-dir .",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "bun run type-check"
  },
  "devDependencies": {
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "web-ext": "^10.1.0"
  }
}
